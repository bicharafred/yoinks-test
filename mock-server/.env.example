# Yoinks Mock Server — config
# ----------------------------
# Copy this file to .env and fill in your values.
# This file is safe to commit. The .env file it produces is NOT.

# ── Environment ───────────────────────────────────────────────────────────────
# local   = local development (default)
# staging = hosted on Railway/Render/Fly for APK testing
APP_ENV=local

# ── Network ───────────────────────────────────────────────────────────────────
# Port the HTTP server listens on. Railway/Render set this automatically.
PORT=4000

# Public base URL used when constructing absolute upload/media URLs.
# Local:   http://localhost:4000
# Hosted:  https://your-mock-server.onrender.com  (replace with actual URL)
PUBLIC_API_BASE_URL=http://localhost:4000

# ── Payment mode ──────────────────────────────────────────────────────────────
# true  = fake payment intents — no Stripe keys needed; fastest for local dev.
# false = real Stripe test mode — requires sk_test_... keys below.
MOCK_PAYMENTS=true

# ── Stripe test keys (optional — only needed when MOCK_PAYMENTS=false) ────────
# 1. Get your test keys from https://dashboard.stripe.com/test/apikeys
# 2. Fill in STRIPE_SECRET_KEY (starts with sk_test_)
# 3. Run: stripe listen --forward-to localhost:4000/stripe/webhook
#    Copy the "Ready! Your webhook signing secret is whsec_..." value
#    and paste it below as STRIPE_WEBHOOK_SECRET.
# 4. Also fill in EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY (pk_test_) in app/.env

STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
