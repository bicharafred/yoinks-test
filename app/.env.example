# Yoinks App — local dev environment
# ------------------------------------
# Copy this file to .env and adjust values for your setup.
# This file is safe to commit. The .env file it produces is NOT.

# App environment — controls runtime feature flag defaults.
# Values: local | staging | production
EXPO_PUBLIC_APP_ENV=local

# Mock server URLs — point to the local mock server on port 4000.
EXPO_PUBLIC_API_BASE=http://127.0.0.1:4000/graphql
EXPO_PUBLIC_API_BASE_REST=http://127.0.0.1:4000/

# Stripe publishable key — leave empty to use MOCK_PAYMENTS mode.
# Fill in a pk_test_... value only when testing real Stripe payments.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=

# Android networking mode for local dev.
# false = Android Emulator (AVD) — remaps 127.0.0.1 → 10.0.2.2 automatically. (default)
# true  = physical device with `adb reverse` — run: adb reverse tcp:4000 tcp:4000
# iOS Simulator is unaffected by this flag (Platform.OS !== "android").
EXPO_PUBLIC_USE_ADB_REVERSE=false

# Google Sign-In web client ID — leave empty to skip Google auth in local dev.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Video upload gate — keep false until the full FFmpeg processing pipeline is ready.
# Set to true only when video capture, processing, and upload are fully tested.
EXPO_PUBLIC_VIDEO_ENABLED=false

# Feature flags — enable mock/dev product flows.
# In production all of these must be false (or absent).
# In staging APK these are set via eas.json "staging-apk" profile env block.
EXPO_PUBLIC_ENABLE_DEV_LOGIN=true
EXPO_PUBLIC_ENABLE_MOCK_PAYMENTS=true
EXPO_PUBLIC_ENABLE_MOCK_PAYOUT=true
EXPO_PUBLIC_ENABLE_MOCK_UPLOADS=true
