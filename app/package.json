{
  "name": "yoinks-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "typecheck": "node scripts/generate-expo-typed-routes.cjs && tsc --noEmit",
    "start": "expo start --dev-client",
    "local": "expo start --dev-client",
    "local:ios": "expo start --dev-client --ios",
    "local:android:emu": "EXPO_PUBLIC_USE_ADB_REVERSE=false expo start --dev-client --android",
    "local:android:device": "adb reverse tcp:4000 tcp:4000 && adb reverse tcp:8081 tcp:8081 && EXPO_PUBLIC_USE_ADB_REVERSE=true expo start --dev-client",
    "start:stg": "env-cmd -f .env.staging expo start -c --dev-client",
    "start:prod": "env-cmd -f .env.production expo start -c --dev-client",
    "android:stg": "env-cmd -f .env.staging expo run:android",
    "ios:stg": "env-cmd -f .env.staging expo run:ios",
    "android:prod": "env-cmd -f .env.production expo run:android",
    "ios:prod": "env-cmd -f .env.production expo run:ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "codegen": "node -e \"console.error('GraphQL codegen is disabled until codegen.ts and schema are restored. See README.md.'); process.exit(1)\"",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@apollo/client": "^4.1.7",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@stripe/stripe-react-native": "0.50.3",
    "@xstate/react": "^6.1.0",
    "aws-appsync-auth-link": "^4.0.2",
    "aws-appsync-subscription-link": "^4.0.3",
    "date-fns": "^4.1.0",
    "expo": "~54.0.34",
    "expo-apple-authentication": "~8.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "ffmpeg-kit-react-native": "^6.0.2",
    "graphql": "^16.13.2",
    "jwt-decode": "^4.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-image": "^0.14.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-toast-message": "^2.3.3",
    "react-native-unistyles": "^3.2.3",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "rxjs": "^7.8.2",
    "xstate": "^5.30.0"
  },
  "devDependencies": {
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "~19.1.0",
    "env-cmd": "^11.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "ffmpeg-kit-react-native"
        ]
      }
    }
  }
}
