# ── General ───────────────────────────────────────────────────────────────────
.DS_Store
__MACOSX/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.orig

# ── Secrets / environment files ──────────────────────────────────────────────
# NEVER commit .env files. Use .env.example to document required variables.
.env
.env.*
!.env.example

# ── Claude Code project memory (local machine only) ───────────────────────────
.claude/

# ── Node / package managers ───────────────────────────────────────────────────
node_modules/

# ── Expo / React Native (app/) ────────────────────────────────────────────────
# Note: app/.gitignore already covers these, but listed here for clarity.
app/.expo/
app/dist/
app/web-build/

# ── iOS (app/ios/) ────────────────────────────────────────────────────────────
# app/.gitignore ignores the full ios/ directory; listed here as safety net.
*.ipa
*.xcarchive
DerivedData/

# ── Android (app/android/) ───────────────────────────────────────────────────
# app/.gitignore ignores the full android/ directory; listed here as safety net.
*.apk
*.aab
*.keystore
*.jks

# ── Mock-server ───────────────────────────────────────────────────────────────
# Temporary upload files (stored in OS temp dir, but protect any local overrides)
mock-server/uploads/
mock-server/tmp/
mock-server/.cache/
